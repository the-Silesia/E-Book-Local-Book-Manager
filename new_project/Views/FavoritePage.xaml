<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="new_project.Views.FavoritePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:new_project.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <local:FavoriteGlyphConverter x:Key="FavoriteGlyphConverter"/>
        <local:ReadingProgressConverter x:Key="ReadingProgressConverter"/>
        <local:ReadingProgressVisibilityConverter x:Key="ReadingProgressVisibilityConverter"/>
        <local:BookTooltipConverter x:Key="BookTooltipConverter"/>
    </Page.Resources>

    <Grid>
        <!--空状态提示-->
        <Grid x:Name="FavoritePage_nullContent_Info" Visibility="Visible">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Uid="FavoritePage_nullContent_Info_Text"
                           Style="{StaticResource TitleLargeTextBlockStyle}"
                           Margin="12"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Grid>

        <Grid x:Name="FavoritePageContent" Visibility="Collapsed">
            <GridView x:Name="FavoriteGridView"
                      IsItemClickEnabled="True"
                      SelectionMode="None"
                      Padding="24"
                      ItemsSource="{Binding FavoriteBooks}"
                      ItemClick="FavoriteGridView_ItemClick">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"
                                       MaximumRowsOrColumns="0"
                                       ItemWidth="200"
                                       ItemHeight="310"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180"
                                Height="302"
                                Margin="8"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch">
                                    <Border CornerRadius="8,8,0,0">
                                        <Image Source="{Binding CoverPath}"
                                               Stretch="UniformToFill"/>
                                    </Border>
                                    <Grid Width="32"
                                          Height="32"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="8">
                                        <Button HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Padding="0"
                                                CornerRadius="4"
                                                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                                Click="FavoriteButton_Click">
                                            <FontIcon Glyph="{Binding IsFavorite, Converter={StaticResource FavoriteGlyphConverter}}"
                                                      FontSize="14"/>
                                            <Button.Resources>
                                                <StaticResource x:Key="ButtonBackgroundPointerOver"
                                                                 ResourceKey="AcrylicBackgroundFillColorDefaultBrush"/>
                                                <StaticResource x:Key="ButtonBackgroundPressed"
                                                                 ResourceKey="AcrylicBackgroundFillColorDefaultBrush"/>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                    <ProgressBar Maximum="100"
                                                 Height="6"
                                                 VerticalAlignment="Bottom"
                                                 HorizontalAlignment="Stretch"
                                                 CornerRadius="2"
                                                 Visibility="{Binding ReadingProgress, Converter={StaticResource ReadingProgressVisibilityConverter}}"
                                                 Value="{Binding ReadingProgress, Converter={StaticResource ReadingProgressConverter}}"/>
                                </Grid>
                                <StackPanel Grid.Row="1"
                                            Height="48"
                                            Padding="10,6"
                                            Spacing="2">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1">
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="{Binding Converter={StaticResource BookTooltipConverter}}"/>
                                        </ToolTipService.ToolTip>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
