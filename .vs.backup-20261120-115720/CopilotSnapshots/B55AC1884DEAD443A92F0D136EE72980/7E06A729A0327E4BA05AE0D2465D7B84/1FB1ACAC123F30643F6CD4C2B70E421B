using CommunityToolkit.Mvvm.ComponentModel;
using new_project.Models;
using new_project.Models.Repository;
using System;
using System.Collections.ObjectModel;
using System.IO;
using System.Linq;
using System.Threading.Tasks;

namespace new_project.ViewModels;

public partial class BooksViewModel : ObservableObject
{
    public ObservableCollection<Book> Books { get; } = new();
    public ObservableCollection<BookList> BookLists { get; } = new();

    [ObservableProperty]
    public partial bool IsLoading { get; set; }

    [ObservableProperty]
    public partial bool HasBooks { get; set; }

    [ObservableProperty]
    public partial bool HasBookLists { get; set; }

    public async Task LoadAsync()
    {
        if (IsLoading)
        {
            return;
        }

        IsLoading = true;
        try
        {
            var books = await DataAccess.GetBooksAsync();
            var bookLists = await DataAccess.GetBookListsAsync();

            Books.Clear();
            foreach (var book in books)
            {
                Books.Add(book);
            }

            BookLists.Clear();
            foreach (var bookList in bookLists)
            {
                BookLists.Add(bookList);
            }

            HasBooks = Books.Count > 0;
            HasBookLists = BookLists.Count > 0;
        }
        finally
        {
            IsLoading = false;
        }
    }

    public async Task<BookList> ImportBookListAsync(string folderPath)
    {
        if (!Directory.Exists(folderPath))
        {
            throw new DirectoryNotFoundException("找不到要导入的文件夹。" + Environment.NewLine + folderPath);
        }

        var fullFolderPath = Path.GetFullPath(folderPath);
        var bookPaths = Directory.EnumerateFiles(
                fullFolderPath,
                "*.txt",
                SearchOption.TopDirectoryOnly)
            .OrderBy(path => path, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (bookPaths.Count == 0)
        {
            throw new InvalidOperationException("所选文件夹中没有可识别的 TXT 书籍文件。" + Environment.NewLine + fullFolderPath);
        }

        var folderName = new DirectoryInfo(fullFolderPath).Name;
        var bookList = await DataAccess.AddOrGetBookListAsync(fullFolderPath, folderName);

        foreach (var bookPath in bookPaths)
        {
            using (File.OpenRead(bookPath))
            {
            }

            var title = Path.GetFileNameWithoutExtension(bookPath);
            var book = await DataAccess.AddOrGetBookAsync(title, bookPath);
            await DataAccess.AddBookToListAsync(bookList.Id, book.Id);

            if (!bookList.Books.Any(existingBook => existingBook.Id == book.Id))
            {
                bookList.Books.Add(book);
            }

            if (!Books.Any(existingBook => existingBook.Id == book.Id))
            {
                Books.Insert(0, book);
            }
        }

        if (!BookLists.Any(existingBookList => existingBookList.Id == bookList.Id))
        {
            BookLists.Insert(0, bookList);
        }

        HasBooks = Books.Count > 0;
        HasBookLists = BookLists.Count > 0;
        return bookList;
    }

}