<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="new_project.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:new_project.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <local:FavoriteGlyphConverter x:Key="FavoriteGlyphConverter"/>
        <local:ReadingProgressConverter x:Key="ReadingProgressConverter"/>
        <local:ReadingProgressVisibilityConverter x:Key="ReadingProgressVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <!--空状态提示 引导用户添加文件-->
        <Grid x:Name="HomePage_nullContent_Info" Visibility="Visible">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                       x:Uid="HomePage_nullContent_Info_Text"
                       Style="{StaticResource TitleLargeTextBlockStyle}"
                       HorizontalAlignment="Center"/>
                <Button Grid.Row="1"
                    x:Uid="HomePage_nullContent_Info_Button"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    Click="HomePageImportButton_Click"/>
            </Grid>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <CommandBar x:Name="HomePageCommandBar"
                        Grid.Row="0"
                        IsOpen="False"
                        DefaultLabelPosition="Right"
                        Visibility="Collapsed">
                <!--排序按钮-->
                <AppBarButton x:Name="SortButton"
                              Icon="Sort"
                              x:Uid="HomePage_AppBarButton_Sort">
                    <Button.Flyout>
                        <MenuFlyout>
                            <!--按最后阅读时间排序 默认选择-->
                            <RadioMenuFlyoutItem x:Uid="HomePage_AppBarButton_Sort_SortByLastReadTime"
                                                 GroupName="HomePageSortGroup"
                                                 IsChecked="True"
                                                 Tag="LastRead"
                                                 Click="SortMenuItem_Click"/>
                            <!--按添加时间排序 从后往前-->
                            <RadioMenuFlyoutItem x:Uid="HomePage_AppBarButton_Sort_SortByTime_LASTtoEARLY"
                                                 GroupName="HomePageSortGroup"
                                                 Tag="AddedDescending"
                                                 Click="SortMenuItem_Click"/>
                            <!--按添加时间排序 从前往后-->
                            <RadioMenuFlyoutItem x:Uid="HomePage_AppBarButton_Sort_SortByTime_EARLYtoLAST"
                                                 GroupName="HomePageSortGroup"
                                                 Tag="AddedAscending"
                                                 Click="SortMenuItem_Click"/>
                            <!--按名称排序 A-Z-->
                            <RadioMenuFlyoutItem x:Uid="HomePage_AppBarButton_Sort_SortByName_AtoZ"
                                                 GroupName="HomePageSortGroup"
                                                 Tag="NameAscending"
                                                 Click="SortMenuItem_Click"/>
                            <!--按名称排序 Z-A-->
                            <RadioMenuFlyoutItem x:Uid="HomePage_AppBarButton_Sort_SortByName_ZtoA"
                                                 GroupName="HomePageSortGroup"
                                                 Tag="NameDescending"
                                                 Click="SortMenuItem_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </AppBarButton>
                <!--书单筛选-->
                <AppBarButton x:Name="BookmarksButton"
                              Icon="Bookmarks"
                              x:Uid="HomePage_AppBarButton_Bookmarks">
                    <Button.Flyout>
                        <MenuFlyout>
                            <!--按书单名绑定添加ToggleMenuFlyoutItem，默认全选-->
                        </MenuFlyout>
                    </Button.Flyout>
                </AppBarButton>
                <!--书单更新扫描-->
                <AppBarButton Icon="Refresh"
                              x:Uid="HomePage_AppBarButton_Refresh"
                              Click="RefreshButton_Click"/>
                <!--添加新书单-->
                <AppBarButton Icon="Add"
                              x:Uid="HomePage_AppBarButton_Add"
                              Click="HomePageImportButton_Click"/>
            </CommandBar>
            <!--内容区 带滚动条-->
            <Grid x:Name="HomePageContent" Grid.Row="1">
                <!--GridView自带ScrollViewer-->
                <GridView x:Name="BookGridView"
                          IsItemClickEnabled="True"
                          SelectionMode="None"
                          Padding="24"
                          ItemsSource="{Binding DisplayedBooks}"
                          ItemClick="BookGridView_ItemClick">
                    <!--局定义：控制卡片如何换行和间距 -->
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                               MaximumRowsOrColumns="0" 
                               ItemWidth="200" 
                               ItemHeight="310"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <!--卡片模板-->
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <!-- 卡片容器：尺寸固定为 180x302 (可根据封面比例调整) -->
                            <Border Width="180" Height="302" Margin="8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!--封面区域自适应-->
                                        <RowDefinition Height="*"/>
                                        <!--底部名称栏-->
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!--封面区域-->
                                    <Grid Grid.Row="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                        <!--封面图-->
                                        <Border CornerRadius="8,8,0,0">
                                            <Image Source="{Binding CoverPath}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <!--右下角收藏按钮 (覆盖在封面之上)-->
                                        <Grid Width="32"
                                              Height="32"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom"
                                              Margin="8">
                                            <Button HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                                    Click="FavoriteButton_Click">
                                                <!--收藏按钮图标 根据收藏状态在Glyph="&#xE734;"和Glyph="&#xE735;"之间切换，Glyph="&#xE734;"是未收藏状态-->
                                                <FontIcon Glyph="{Binding IsFavorite, Converter={StaticResource FavoriteGlyphConverter}}"
                                                          FontSize="14"/>
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver"
                                                                    ResourceKey="AcrylicBackgroundFillColorDefaultBrush"/>
                                                    <StaticResource x:Key="ButtonBackgroundPressed"
                                                                    ResourceKey="AcrylicBackgroundFillColorDefaultBrush"/>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                         <!--封面底部固定阅读进度条 仅在进度不为零时可见-->
                                        <ProgressBar Maximum="100"
                                                     Height="6"
                                                     VerticalAlignment="Bottom"
                                                     HorizontalAlignment="Stretch"
                                                     CornerRadius="2"
                                                      Visibility="{Binding ReadingProgress, Converter={StaticResource ReadingProgressVisibilityConverter}}"
                                                     Value="{Binding ReadingProgress, Converter={StaticResource ReadingProgressConverter}}"/>
                                    </Grid>
                                    <!--底部名称栏-->
                                    <StackPanel Grid.Row="1" Height="48" Padding="10,6" Spacing="2">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1">
                                            <!--ToolTip 鼠标悬浮显示完整名称，阅读进度（如果有），最后阅读时间（如果有）-->
                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="{Binding Title}"/>
                                            </ToolTipService.ToolTip>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>
    </Grid>
</Page>
