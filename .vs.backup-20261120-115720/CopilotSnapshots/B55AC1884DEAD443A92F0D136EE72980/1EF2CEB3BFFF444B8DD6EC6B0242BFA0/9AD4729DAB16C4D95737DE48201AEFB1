<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="new_project.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ScrollViewer x:Name="ReaderScrollViewer"
                          Padding="8,16"
                          VerticalScrollBarVisibility="Auto"
                          ViewChanged="ReaderScrollViewer_ViewChanged">
                <TextBlock x:Name="ReaderTextBlock"
                           TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}"/>
            </ScrollViewer>

            <Grid x:Name="PagedReaderPanel"
                  Visibility="Collapsed">
                <Image x:Name="PagedReaderImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Grid>

            <Button x:Name="PreviousPageButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="PreviousPageButton_Click"
                    Visibility="Collapsed"
                    Margin="0,0,12,0"
                    x:Uid="Reader_PreviousPageButton"
					>
				<FontIcon Glyph="&#xE76B;" />
            </Button>
            <Button x:Name="NextPageButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="NextPageButton_Click"
                    Visibility="Collapsed"
                    Margin="12,0,0,0"
                    x:Uid="Reader_NextPageButton">
                <FontIcon Glyph="&#xE76C;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="8,16,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0"
                         x:Name="ReadingProgressBar"
                         Height="4"
                         Minimum="0"
                         Maximum="1"
                         VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       x:Name="ReadingProgressText"
                       Margin="12"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
