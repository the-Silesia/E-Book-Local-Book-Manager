using Microsoft.Data.Sqlite;
using new_project.Models;
using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Threading;
using System.Threading.Tasks;
using Windows.Storage;

namespace new_project.Models.Repository;

public static class DataAccess
{
    private const string DatabaseFileName = "books.db";
    private static readonly SemaphoreSlim InitializationLock = new(1, 1);
    private static bool _isInitialized;

    private static string DatabasePath => Path.Combine(
        ApplicationData.Current.LocalFolder.Path,
        DatabaseFileName);

    public static async Task InitializeAsync()
    {
        if (_isInitialized)
        {
            return;
        }

        await InitializationLock.WaitAsync();
        try
        {
            if (_isInitialized)
            {
                return;
            }

            using var connection = CreateConnection();
            await connection.OpenAsync();

            using var command = connection.CreateCommand();
            command.CommandText = """
                CREATE TABLE IF NOT EXISTS Books (
                    Id INTEGER PRIMARY KEY AUTOINCREMENT,
                    Title TEXT NOT NULL,
                    CoverPath TEXT NULL,
                    DateAdded TEXT NOT NULL,
                    BookPath TEXT NOT NULL UNIQUE,
                    IsFavorite INTEGER NOT NULL DEFAULT 0
                );

                CREATE TABLE IF NOT EXISTS ReadingProgress (
                    BookId INTEGER PRIMARY KEY,
                    Progress TEXT NOT NULL DEFAULT '0',
                    DateLastOpened TEXT NULL,
                    FOREIGN KEY (BookId) REFERENCES Books(Id) ON DELETE CASCADE
                );
                """;
            await command.ExecuteNonQueryAsync();
            _isInitialized = true;
        }
        finally
        {
            InitializationLock.Release();
        }
    }

    public static async Task<IReadOnlyList<Book>> GetBooksAsync()
    {
        await InitializeAsync();

        using var connection = await OpenConnectionAsync();
        using var command = connection.CreateCommand();
        command.CommandText = """
            SELECT
                b.Id,
                b.Title,
                b.CoverPath,
                b.DateAdded,
                b.BookPath,
                b.IsFavorite,
                p.Progress,
                p.DateLastOpened
            FROM Books AS b
            LEFT JOIN ReadingProgress AS p ON p.BookId = b.Id
            ORDER BY COALESCE(p.DateLastOpened, b.DateAdded) DESC;
            """;

        var books = new List<Book>();
        using var reader = await command.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            books.Add(ReadBook(reader));
        }

        return books;
    }

    public static async Task<Book?> GetBookAsync(int id)
    {
        await InitializeAsync();

        using var connection = await OpenConnectionAsync();
        using var command = connection.CreateCommand();
        command.CommandText = """
            SELECT
                b.Id,
                b.Title,
                b.CoverPath,
                b.DateAdded,
                b.BookPath,
                b.IsFavorite,
                p.Progress,
                p.DateLastOpened
            FROM Books AS b
            LEFT JOIN ReadingProgress AS p ON p.BookId = b.Id
            WHERE b.Id = $id;
            """;
        command.Parameters.AddWithValue("$id", id);

        using var reader = await command.ExecuteReaderAsync();
        return await reader.ReadAsync() ? ReadBook(reader) : null;
    }

    public static async Task<Book> AddOrGetBookAsync(string title, string bookPath)
    {
        await InitializeAsync();

        var fullPath = Path.GetFullPath(bookPath);
        using var connection = await OpenConnectionAsync();

        using (var findCommand = connection.CreateCommand())
        {
            findCommand.CommandText = "SELECT Id FROM Books WHERE BookPath = $bookPath;";
            findCommand.Parameters.AddWithValue("$bookPath", fullPath);
            var existingId = await findCommand.ExecuteScalarAsync();
            if (existingId is not null && existingId != DBNull.Value)
            {
                return (await GetBookAsync(Convert.ToInt32(existingId, CultureInfo.InvariantCulture)))!;
            }
        }

        using var transaction = connection.BeginTransaction();
        using (var insertCommand = connection.CreateCommand())
        {
            insertCommand.Transaction = transaction;
            insertCommand.CommandText = """
                INSERT INTO Books (Title, DateAdded, BookPath)
                VALUES ($title, $dateAdded, $bookPath);
                """;
            insertCommand.Parameters.AddWithValue("$title", title);
            insertCommand.Parameters.AddWithValue("$dateAdded", FormatDate(DateTime.Now));
            insertCommand.Parameters.AddWithValue("$bookPath", fullPath);
            await insertCommand.ExecuteNonQueryAsync();
        }

        long bookId;
        using (var idCommand = connection.CreateCommand())
        {
            idCommand.Transaction = transaction;
            idCommand.CommandText = "SELECT last_insert_rowid();";
            bookId = (long)(await idCommand.ExecuteScalarAsync())!;
        }

        using (var progressCommand = connection.CreateCommand())
        {
            progressCommand.Transaction = transaction;
            progressCommand.CommandText = """
                INSERT INTO ReadingProgress (BookId, Progress)
                VALUES ($bookId, '0');
                """;
            progressCommand.Parameters.AddWithValue("$bookId", bookId);
            await progressCommand.ExecuteNonQueryAsync();
        }

        await transaction.CommitAsync();
        return (await GetBookAsync(Convert.ToInt32(bookId, CultureInfo.InvariantCulture)))!;
    }

    public static async Task UpdateReadingProgressAsync(int bookId, string progress, DateTime lastOpened)
    {
        await InitializeAsync();

        using var connection = await OpenConnectionAsync();
        using var command = connection.CreateCommand();
        command.CommandText = """
            INSERT INTO ReadingProgress (BookId, Progress, DateLastOpened)
            VALUES ($bookId, $progress, $lastOpened)
            ON CONFLICT(BookId) DO UPDATE SET
                Progress = excluded.Progress,
                DateLastOpened = excluded.DateLastOpened;
            """;
        command.Parameters.AddWithValue("$bookId", bookId);
        command.Parameters.AddWithValue("$progress", progress);
        command.Parameters.AddWithValue("$lastOpened", FormatDate(lastOpened));
        await command.ExecuteNonQueryAsync();
    }

    public static async Task UpdateFavoriteAsync(int bookId, bool isFavorite)
    {
        await InitializeAsync();

        using var connection = await OpenConnectionAsync();
        using var command = connection.CreateCommand();
        command.CommandText = "UPDATE Books SET IsFavorite = $isFavorite WHERE Id = $id;";
        command.Parameters.AddWithValue("$isFavorite", isFavorite ? 1 : 0);
        command.Parameters.AddWithValue("$id", bookId);
        await command.ExecuteNonQueryAsync();
    }

    private static SqliteConnection CreateConnection()
    {
        return new SqliteConnection($"Data Source={DatabasePath}");
    }

    private static async Task<SqliteConnection> OpenConnectionAsync()
    {
        var connection = CreateConnection();
        await connection.OpenAsync();
        return connection;
    }

    private static Book ReadBook(SqliteDataReader reader)
    {
        var book = new Book(
            reader.GetInt32(reader.GetOrdinal("Id")),
            reader.GetString(reader.GetOrdinal("Title")),
            reader.GetString(reader.GetOrdinal("BookPath")))
        {
            CoverPath = ReadNullableString(reader, "CoverPath"),
            DateAdded = ParseDate(reader.GetString(reader.GetOrdinal("DateAdded"))),
            ReadingProgress = ReadNullableString(reader, "Progress") ?? "0",
            DateLastOpened = ReadNullableDate(reader, "DateLastOpened"),
            IsFavorite = reader.GetInt32(reader.GetOrdinal("IsFavorite")) != 0
        };

        return book;
    }

    private static string? ReadNullableString(SqliteDataReader reader, string columnName)
    {
        var ordinal = reader.GetOrdinal(columnName);
        return reader.IsDBNull(ordinal) ? null : reader.GetString(ordinal);
    }

    private static DateTime? ReadNullableDate(SqliteDataReader reader, string columnName)
    {
        var value = ReadNullableString(reader, columnName);
        return value is null ? null : ParseDate(value);
    }

    private static string FormatDate(DateTime value)
    {
        return value.ToString("O", CultureInfo.InvariantCulture);
    }

    private static DateTime ParseDate(string value)
    {
        return DateTime.Parse(value, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind);
    }
}