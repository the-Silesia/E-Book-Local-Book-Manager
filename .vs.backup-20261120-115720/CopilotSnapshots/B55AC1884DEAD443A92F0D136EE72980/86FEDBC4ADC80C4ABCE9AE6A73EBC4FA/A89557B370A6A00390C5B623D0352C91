using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;
using Microsoft.UI.Xaml.Navigation;
using new_project.Models;
using new_project.Services;
using new_project.ViewModels;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Windows.Storage.Pickers;
using WinRT.Interop;

// To learn more about WinUI, the WinUI project structure,
// and more about our project templates, see: http://aka.ms/winui-project-info.

namespace new_project.Views
{
    /// <summary>
    /// An empty page that can be used on its own or navigated to within a Frame.
    /// </summary>
    public sealed partial class HomePage : Page
    {
        private BooksViewModel ViewModel => App.LibraryViewModel;
        private HomePageViewModel HomeViewModel { get; }
        private readonly FolderAccessService _folderAccessService = new();

        public HomePage()
        {
            InitializeComponent();
            DataContext = ViewModel;
            HomeViewModel = new HomePageViewModel(ViewModel);
            BookGridView.DataContext = HomeViewModel;
        }

        protected override async void OnNavigatedTo(NavigationEventArgs e)
        {
            base.OnNavigatedTo(e);

            try
            {
                await ViewModel.LoadAsync();
                HomeViewModel.Refresh();
                BuildBookListFilterMenu();
                UpdateViewState();
            }
            catch (Exception exception)
            {
                await ShowErrorAsync(exception.Message);
            }
        }

        private async void HomePageImportButton_Click(object sender, RoutedEventArgs e)
        {
            if (App.CurrentWindow is null)
            {
                return;
            }

            var picker = new FolderPicker();
            picker.FileTypeFilter.Add("*");
            InitializeWithWindow.Initialize(picker, WindowNative.GetWindowHandle(App.CurrentWindow));

            var folder = await picker.PickSingleFolderAsync();
            if (folder is null)
            {
                return;
            }

            try
            {
                var futureAccessToken = _folderAccessService.AddToFutureAccessList(folder);
                var scanResults = await ScanFolderAsync(folder, futureAccessToken);
                if (scanResults is null)
                {
                    return;
                }

                var resultDialog = new ContentDialog
                {
                    XamlRoot = XamlRoot,
                    Title = "扫描结果",
                    Content = $"该目录下扫描到 {scanResults.Count} 个项目",
                    PrimaryButtonText = "确认添加",
                    CloseButtonText = "取消",
                    DefaultButton = ContentDialogButton.Primary
                };

                if (await resultDialog.ShowAsync() != ContentDialogResult.Primary)
                {
                    return;
                }

                await ViewModel.ImportBookListAsync(folder, futureAccessToken, scanResults);
                HomeViewModel.Refresh();
                BuildBookListFilterMenu();
                UpdateViewState();
            }
            catch (Exception exception)
            {
                await ShowErrorAsync(exception.Message);
            }
        }

        private async Task<IReadOnlyList<BookScanResult>?> ScanFolderAsync(
            Windows.Storage.StorageFolder folder,
            string futureAccessToken)
        {
            if (XamlRoot is null)
            {
                return null;
            }

            var progressBar = new ProgressBar
            {
                IsIndeterminate = true,
                HorizontalAlignment = HorizontalAlignment.Stretch
            };
            var progressDialog = new ContentDialog
            {
                XamlRoot = XamlRoot,
                Title = "正在扫描",
                Content = progressBar,
                IsPrimaryButtonEnabled = false,
                IsSecondaryButtonEnabled = false
            };

            var scanTask = ViewModel.ScanBookListAsync(folder, futureAccessToken);
            var showTask = progressDialog.ShowAsync().AsTask();
            try
            {
                return await scanTask;
            }
            finally
            {
                if (progressDialog.XamlRoot is not null)
                {
                    progressDialog.Hide();
                }

                await showTask;
            }
        }

        private async void RefreshButton_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                await ViewModel.LoadAsync();
                HomeViewModel.Refresh();
                BuildBookListFilterMenu();
                UpdateViewState();
            }
            catch (Exception exception)
            {
                await ShowErrorAsync(exception.Message);
            }
        }

        private void BookGridView_ItemClick(object sender, ItemClickEventArgs e)
        {
            if (e.ClickedItem is Book book)
            {
                Frame?.Navigate(typeof(ReaderPage), book.Id);
            }
        }

        private async void FavoriteButton_Click(object sender, RoutedEventArgs e)
        {
            if (sender is not Button button || button.DataContext is not Book book)
            {
                return;
            }

            try
            {
                await ViewModel.SetFavoriteAsync(book, !book.IsFavorite);
            }
            catch (Exception exception)
            {
                await ShowErrorAsync(exception.Message);
            }
        }

        private void SortMenuItem_Click(object sender, RoutedEventArgs e)
        {
            if (sender is RadioMenuFlyoutItem { Tag: string tag }
                && Enum.TryParse<SortMode>(tag, out var sortMode))
            {
                HomeViewModel.SetSortMode((HomePageSortMode)sortMode);
            }
        }

        private void BookListFilterItem_Click(object sender, RoutedEventArgs e)
        {
            if (sender is not ToggleMenuFlyoutItem item)
            {
                return;
            }

            if (item.Tag is int bookListId)
            {
                HomeViewModel.SetBookListSelected(bookListId, item.IsChecked);
                UpdateAllBookListsFilterItem();
            }
            else
            {
                HomeViewModel.SetAllBookListsSelected(item.IsChecked);
                UpdateBookListFilterItemStates();
            }
        }

        private void UpdateViewState()
        {
            var hasBooks = ViewModel.Books.Count > 0;
            var hasBookLists = ViewModel.BookLists.Count > 0;
            HomePage_nullContent_Info.Visibility = hasBooks ? Visibility.Collapsed : Visibility.Visible;
            HomePageCommandBar.Visibility = hasBookLists ? Visibility.Visible : Visibility.Collapsed;
            HomePageContent.Visibility = hasBooks ? Visibility.Visible : Visibility.Collapsed;
            HomeViewModel.Refresh();
        }

        private void BuildBookListFilterMenu()
        {
            if (BookmarksButton.Flyout is not MenuFlyout menuFlyout)
            {
                return;
            }

            var bookListIds = ViewModel.BookLists.Select(bookList => bookList.Id).ToHashSet();

            menuFlyout.Items.Clear();
            var allItem = new ToggleMenuFlyoutItem
            {
                Text = "全部书单",
                IsChecked = bookListIds.Count > 0 && HomeViewModel.SelectedBookListIds.Count == bookListIds.Count
            };
            allItem.Click += BookListFilterItem_Click;
            menuFlyout.Items.Add(allItem);

            foreach (var bookList in ViewModel.BookLists.OrderBy(bookList => bookList.ListName, StringComparer.CurrentCultureIgnoreCase))
            {
                var item = new ToggleMenuFlyoutItem
                {
                    Text = bookList.ListName,
                    Tag = bookList.Id,
                    IsChecked = HomeViewModel.SelectedBookListIds.Contains(bookList.Id)
                };
                item.Click += BookListFilterItem_Click;
                menuFlyout.Items.Add(item);
            }
        }

        private void UpdateAllBookListsFilterItem()
        {
            if (BookmarksButton.Flyout is not MenuFlyout menuFlyout)
            {
                return;
            }

            var allItem = menuFlyout.Items.OfType<ToggleMenuFlyoutItem>().FirstOrDefault(item => item.Tag is null);
            if (allItem is not null)
            {
                    allItem.IsChecked = ViewModel.BookLists.Count > 0
                    && HomeViewModel.SelectedBookListIds.Count == ViewModel.BookLists.Count;
            }
        }

        private void UpdateBookListFilterItemStates()
        {
            if (BookmarksButton.Flyout is not MenuFlyout menuFlyout)
            {
                return;
            }

            foreach (var item in menuFlyout.Items.OfType<ToggleMenuFlyoutItem>())
            {
                if (item.Tag is int bookListId)
                {
                    item.IsChecked = HomeViewModel.SelectedBookListIds.Contains(bookListId);
                }
            }

            UpdateAllBookListsFilterItem();
        }

        private async Task ShowErrorAsync(string message)
        {
            if (XamlRoot is null)
            {
                return;
            }

            var dialog = new ContentDialog
            {
                XamlRoot = XamlRoot,
                Title = "导入失败",
                Content = message,
                CloseButtonText = "确定"
            };
            await dialog.ShowAsync();
        }


    }
}
