<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="new_project.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left"
                             Invoked="ReaderPageKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Right"
                             Invoked="ReaderPageKeyboardAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Space"
                             Invoked="ReaderPageKeyboardAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              PointerWheelChanged="ReaderContent_PointerWheelChanged">
            <Button x:Name="FullScreenToggleButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="8"
                    Click="FullScreenToggleButton_Click"
                    AutomationProperties.Name="切换全屏"
                    ToolTipService.ToolTip="切换全屏">
                <FontIcon x:Name="FullScreenToggleIcon"
                          Glyph="&#xE740;"/>
            </Button>
            <ScrollViewer x:Name="ReaderScrollViewer"
                          Padding="8,16"
                          VerticalScrollBarVisibility="Auto"
                          ViewChanged="ReaderScrollViewer_ViewChanged">
                <TextBlock x:Name="ReaderTextBlock"
                           TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}"/>
            </ScrollViewer>

            <Grid x:Name="PagedReaderPanel"
                  Visibility="Collapsed"
                  Background="Transparent"
                  PointerPressed="PagedReaderPanel_PointerPressed">
                <Image x:Name="PagedReaderImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Grid>

            <Button x:Name="PreviousPageButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="PreviousPageButton_Click"
                    Visibility="Collapsed"
                    Margin="0,0,12,0"
                    x:Uid="Reader_PreviousPageButton"
					>
				<FontIcon Glyph="&#xE76B;" />
            </Button>
            <Button x:Name="NextPageButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="NextPageButton_Click"
                    Visibility="Collapsed"
                    Margin="12,0,0,0"
                    x:Uid="Reader_NextPageButton">
                <FontIcon Glyph="&#xE76C;" />
            </Button>
        </Grid>

        <Grid x:Name="ReaderProgressPanel"
              Grid.Row="1"
              Margin="8,16,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0"
                         x:Name="ReadingProgressBar"
                         Height="4"
                         Minimum="0"
                         Maximum="1"
                         VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <NumberBox x:Name="PageNumberBox"
                           Width="112"
                           Minimum="1"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="1"
                           LargeChange="1"
                           Visibility="Collapsed"
                           VerticalAlignment="Center"
                           KeyDown="PageNumberBox_KeyDown"
                           LostFocus="PageNumberBox_LostFocus"/>
                <TextBlock x:Name="PageCountText"
                           Margin="8,0,0,0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ReadingProgressText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
