using System;
using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;
using Microsoft.UI.Xaml.Navigation;
using new_project.Services;
using new_project.ViewModels;
using System.IO;
using Windows.System;

// To learn more about WinUI, the WinUI project structure,
// and more about our project templates, see: http://aka.ms/winui-project-info.

namespace new_project.Views;

/// <summary>
/// An empty page that can be used on its own or navigated to within a Frame.
/// </summary>
public sealed partial class SettingsPage : Page
{
    private MainWindow? MainWindow => App.CurrentWindow as MainWindow;
    private readonly BookCoverService _bookCoverService = new();

    public SettingsPage()
    {
        InitializeComponent();
        AddThemeOptions();
        AddBackdropOptions();
        AddReaderOpenModeOptions();
    }

    private async void ThemeComboBox_SelectionChanged(object sender, SelectionChangedEventArgs e)
    {
        if (ThemeComboBox.SelectedItem is ComboBoxItem { Tag: AppThemeMode theme })
        {
            MainWindow?.SetTheme(theme);
            await AppSettingsService.SaveAsync();
        }
    }

    private async void BackdropComboBox_SelectionChanged(object sender, SelectionChangedEventArgs e)
    {
        if (BackdropComboBox.SelectedItem is ComboBoxItem { Tag: AppBackdropMode backdrop })
        {
            MainWindow?.ApplyBackdrop(backdrop);
            await AppSettingsService.SaveAsync();
        }
    }

    private async void ReaderOpenModeComboBox_SelectionChanged(object sender, SelectionChangedEventArgs e)
    {
        if (ReaderOpenModeComboBox.SelectedItem is ComboBoxItem { Tag: ReaderOpenMode mode })
        {
            AppSettingsService.Current.ReaderOpenMode = mode;
            await AppSettingsService.SaveAsync();
        }

    private void AddThemeOptions()
    {
        AddOption(ThemeComboBox, "跟随系统", AppThemeMode.System, AppSettingsService.Current.Theme);
        AddOption(ThemeComboBox, "浅色", AppThemeMode.Light, AppSettingsService.Current.Theme);
        AddOption(ThemeComboBox, "深色", AppThemeMode.Dark, AppSettingsService.Current.Theme);
    }

    private void AddBackdropOptions()
    {
        AddOption(BackdropComboBox, "Mica", AppBackdropMode.Mica, AppSettingsService.Current.Backdrop);
        AddOption(BackdropComboBox, "Mica Alt", AppBackdropMode.MicaAlt, AppSettingsService.Current.Backdrop);
        AddOption(BackdropComboBox, "Acrylic", AppBackdropMode.Acrylic, AppSettingsService.Current.Backdrop);
        AddOption(BackdropComboBox, "Acrylic Thin", AppBackdropMode.AcrylicThin, AppSettingsService.Current.Backdrop);
    }

    private void AddReaderOpenModeOptions()
    {
        AddOption(ReaderOpenModeComboBox, "独立窗口", ReaderOpenMode.ReaderWindow, AppSettingsService.Current.ReaderOpenMode);
        AddOption(ReaderOpenModeComboBox, "嵌入主窗口", ReaderOpenMode.MainWindow, AppSettingsService.Current.ReaderOpenMode);
    }

    private static void AddOption<T>(ComboBox comboBox, string content, T tag, T selectedTag)
    {
        var item = new ComboBoxItem
        {
            Content = content,
            Tag = tag
        };
        comboBox.Items.Add(item);
        if (Equals(tag, selectedTag))
        {
            comboBox.SelectedItem = item;
        }
    }
    }

    private async void OpenCacheFolderButton_Click(object sender, RoutedEventArgs e)
    {
        Directory.CreateDirectory(BookCoverService.CacheFolderPath);
        await Launcher.LaunchFolderPathAsync(BookCoverService.CacheFolderPath);
    }

    private async void ClearCoverCacheButton_Click(object sender, RoutedEventArgs e)
    {
        if (XamlRoot is null)
        {
            return;
        }

        var dialog = new ContentDialog
        {
            XamlRoot = XamlRoot,
            Title = "清理封面缓存",
            Content = "确定要删除应用生成的所有封面缓存吗？书籍源文件和数据库不会受到影响。",
            PrimaryButtonText = "清理",
            CloseButtonText = "取消",
            DefaultButton = ContentDialogButton.Close
        };

        if (await dialog.ShowAsync() != ContentDialogResult.Primary)
        {
            return;
        }

        try
        {
            await _bookCoverService.ClearCoverCacheAsync();
        }
        catch (Exception exception)
        {
            var errorDialog = new ContentDialog
            {
                XamlRoot = XamlRoot,
                Title = "清理失败",
                Content = exception.Message,
                CloseButtonText = "确定"
            };
            await errorDialog.ShowAsync();
        }
    }
}
