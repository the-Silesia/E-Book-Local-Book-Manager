using System;
using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;
using Microsoft.UI.Xaml.Navigation;
using new_project.Services;
using new_project.ViewModels;
using System;
using System.IO;
using System.Threading.Tasks;
using Windows.System;

// To learn more about WinUI, the WinUI project structure,
// and more about our project templates, see: http://aka.ms/winui-project-info.

namespace new_project.Views;

/// <summary>
/// An empty page that can be used on its own or navigated to within a Frame.
/// </summary>
public sealed partial class SettingsPage : Page
{
    private MainWindow? MainWindow => App.CurrentWindow as MainWindow;
    private readonly BookCoverService _bookCoverService = new();

    public SettingsPage()
    {
        InitializeComponent();
        ThemeComboBox.ItemsSource = Enum.GetValues<AppThemeMode>();
        BackdropComboBox.ItemsSource = Enum.GetValues<AppBackdropMode>();
        ReaderOpenModeComboBox.ItemsSource = Enum.GetValues<ReaderOpenMode>();
        ThemeComboBox.SelectedItem = AppSettingsService.Current.Theme;
        BackdropComboBox.SelectedItem = AppSettingsService.Current.Backdrop;
        ReaderOpenModeComboBox.SelectedItem = AppSettingsService.Current.ReaderOpenMode;
    }

    private async void ThemeComboBox_SelectionChanged(object sender, SelectionChangedEventArgs e)
    {
        if (ThemeComboBox.SelectedItem is AppThemeMode theme)
        {
            MainWindow?.SetTheme(theme);
            await AppSettingsService.SaveAsync();
        }
    }

    private async void BackdropComboBox_SelectionChanged(object sender, SelectionChangedEventArgs e)
    {
        if (BackdropComboBox.SelectedItem is AppBackdropMode backdrop)
        {
            MainWindow?.ApplyBackdrop(backdrop);
            await AppSettingsService.SaveAsync();
        }
    }

    private async void ReaderOpenModeComboBox_SelectionChanged(object sender, SelectionChangedEventArgs e)
    {
        if (ReaderOpenModeComboBox.SelectedItem is ReaderOpenMode mode)
        {
            AppSettingsService.Current.ReaderOpenMode = mode;
            await AppSettingsService.SaveAsync();
        }
    }

    private async void OpenCacheFolderButton_Click(object sender, RoutedEventArgs e)
    {
        Directory.CreateDirectory(BookCoverService.CacheFolderPath);
        await Launcher.LaunchFolderPathAsync(BookCoverService.CacheFolderPath);
    }

    private async void ClearCoverCacheButton_Click(object sender, RoutedEventArgs e)
    {
        if (XamlRoot is null)
        {
            return;
        }

        var dialog = new ContentDialog
        {
            XamlRoot = XamlRoot,
            Title = "清理封面缓存",
            Content = "确定要删除应用生成的所有封面缓存吗？书籍源文件和数据库不会受到影响。",
            PrimaryButtonText = "清理",
            CloseButtonText = "取消",
            DefaultButton = ContentDialogButton.Close
        };

        if (await dialog.ShowAsync() != ContentDialogResult.Primary)
        {
            return;
        }

        try
        {
            await _bookCoverService.ClearCoverCacheAsync();
        }
        catch (Exception exception)
        {
            var errorDialog = new ContentDialog
            {
                XamlRoot = XamlRoot,
                Title = "清理失败",
                Content = exception.Message,
                CloseButtonText = "确定"
            };
            await errorDialog.ShowAsync();
        }
    }
}
