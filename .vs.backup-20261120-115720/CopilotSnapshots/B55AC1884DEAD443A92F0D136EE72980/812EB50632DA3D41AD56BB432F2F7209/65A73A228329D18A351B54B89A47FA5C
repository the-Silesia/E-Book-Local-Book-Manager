<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="new_project.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:new_project"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="new_project">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <!--TitleBar-->
            <RowDefinition Height="Auto"/>
            <!--NavigationView-->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--标题栏-->
        <TitleBar
            x:Name="mainWindowTitleBar"
            x:Uid="mainWindowTitleBar"
            IsBackButtonVisible="False"
            BackRequested="MainWindowTitleBar_BackRequested"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="MainWindowTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/icon.ico"/>
            </TitleBar.IconSource>
            <TitleBar.Content>
                <!--标题栏搜索框-->
                <AutoSuggestBox
                    x:Uid="mainWindowSearchingBox"
                    Width="360"
                    VerticalAlignment="Center"/>
            </TitleBar.Content>
        </TitleBar>
        <!--导航栏 紧凑型-->
        <NavigationView
            x:Name="mainWindowNavView"
            x:Uid="mainWindowNavView"
            Grid.Row="1"
            IsSettingsVisible="True"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            ItemInvoked="mainWindowNavView_ItemInvoked">
            <!--覆盖内容区资源-->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
            </NavigationView.Resources>
            <!--导航项-->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="mainWindowNav_Home" Icon="Library" Tag="Home" IsSelected="True"/>
                <NavigationViewItem x:Uid="mainWindowNav_Collection" Icon="Favorite" Tag="Collection"/>
                <NavigationViewItem x:Uid="mainWindowNav_List" Icon="List" Tag="List"/>
            </NavigationView.MenuItems>
            <Frame x:Name="mainWindowNavFrame"/>
        </NavigationView>
    </Grid>
</Window>
