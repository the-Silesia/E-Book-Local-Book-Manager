namespace new_project
{
    /// <summary>
    /// An empty window that can be used on its own or navigated to within a Frame.
    /// </summary>
    public sealed partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();
            this.ExtendsContentIntoTitleBar = true;
            this.SetTitleBar(mainWindowTitleBar);
            if (this.ExtendsContentIntoTitleBar)
            {
                //标题栏按钮适应TitleBar高度
                AppWindow.TitleBar.PreferredHeightOption = TitleBarHeightOption.Tall;
            }
            mainWindowNavFrame.Navigated += MainWindowNavFrame_Navigated;
            //初始化导航
            mainWindowNavFrame.Navigate(typeof(HomePage));
        }

        private void MainWindowTitleBar_BackRequested(TitleBar sender, object args)
        {
            if (mainWindowNavFrame.CanGoBack)
            {
                mainWindowNavFrame.GoBack();
            }
        }

        private void MainWindowTitleBar_PaneToggleRequested(TitleBar sender, object args)
        {
            mainWindowNavView.IsPaneOpen = !mainWindowNavView.IsPaneOpen;
        }

        private void mainWindowNavView_ItemInvoked(NavigationView sender, NavigationViewItemInvokedEventArgs args)
        {
            if (args.IsSettingsInvoked)
            {
                if (mainWindowNavFrame.CurrentSourcePageType != typeof(SettingsPage))
                {
                    mainWindowNavFrame.Navigate(typeof(SettingsPage), null, args.RecommendedNavigationTransitionInfo);
                    mainWindowTitleBar.IsBackButtonVisible = mainWindowNavFrame.CanGoBack;
                }
                return;
            }
            if(args.InvokedItemContainer is NavigationViewItem item)
            {
                var pageType = item.Tag?.ToString() switch
                {
                    "Home" => typeof(HomePage),
                    "Collection" => typeof(FavoritePage),
                    "List" => typeof(ListPage),
                    _ => null
                };
                if (pageType != null && mainWindowNavFrame.CurrentSourcePageType != pageType)
                {
                    mainWindowNavFrame.Navigate(pageType, null, args.RecommendedNavigationTransitionInfo);
                    mainWindowTitleBar.IsBackButtonVisible = mainWindowNavFrame.CanGoBack;
                }
            }
        }
        private void MainWindowNavFrame_Navigated(object sender, NavigationEventArgs e)
        {
            NavigationViewItem? targetItem = null;
            if (e.SourcePageType == typeof(HomePage))
                targetItem = FindMenuItemByTag("Home");
            else if (e.SourcePageType == typeof(FavoritePage))
                targetItem = FindMenuItemByTag("Collection");
            else if (e.SourcePageType == typeof(ListPage))
                targetItem = FindMenuItemByTag("List");
            else if (e.SourcePageType == typeof(SettingsPage))
            {
                mainWindowNavView.SelectedItem = mainWindowNavView.SettingsItem;
                return;
            }
            if (targetItem != null)
            {
                mainWindowNavView.SelectedItem = targetItem;
            }
        }
        private NavigationViewItem? FindMenuItemByTag(string tag)
        {
            foreach (var item in mainWindowNavView.MenuItems)
            {
                if (item is NavigationViewItem navItem && navItem.Tag?.ToString() == tag)
                    return navItem;
            }
            return null;
        }
    }
}
